# Supabase public client configuration (the anon key is designed for browser use).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Must be a separately provisioned project slug authorized by has_project_access.
SUPABASE_PROJECT_SLUG=minutes_generator

# Local only: use an absolute path outside this project's publicly served directory.
GOOGLE_SERVICE_ACCOUNT_FILE=
# For Vercel, use GOOGLE_SERVICE_ACCOUNT_JSON as a Secret instead; leave FILE unset.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=10hxz_UfN27ZV4lzKeUQ3vNl78pOixWU_oFo0FrGTOM0
GOOGLE_TEMPLATE_ID=replace-with-current-template-id
GOOGLE_DESTINATION_FOLDER_ID=replace-with-shared-drive-folder-id
